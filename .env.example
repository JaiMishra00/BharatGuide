# ---- RAG service (server side; never shipped to a renderer) ----
# Point these at YOUR existing collection (sample values below). Local Docker:
#   QDRANT_URL=http://localhost:6333   (key empty)
# Qdrant Cloud example:
#   QDRANT_URL=https://xxxxxxxx-xxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=gov_docs
# Named vectors in that collection. Empty sparse name = dense-only search.
QDRANT_DENSE_VECTOR=dense
QDRANT_SPARSE_VECTOR=sparse
# 1 = filter payload status=active. Set 0 if your payload has no `status` field.
FILTER_ACTIVE_ONLY=1
# BAAI/bge-m3 (dense+sparse) or BAAI/bge-small-en-v1.5 (dense only, CPU fallback)
EMBED_MODEL=BAAI/bge-m3
EMBED_MAX_LENGTH=512
ABSTAIN_THRESHOLD=0.45
# Shared secret between the Electron main process and the RAG service.
SERVICE_TOKEN=change-me-dev-token
RAG_PORT=8008
# Verify against official pages before a demo.
HELPLINE_ECI=Voter Helpline 1950 (toll-free) | https://voters.eci.gov.in
HELPLINE_UIDAI=UIDAI helpline 1947 (toll-free) | help@uidai.gov.in | https://uidai.gov.in
# Comma separated keywords that mark a query out of scope (procedural scope only).
OUT_OF_SCOPE_KEYWORDS=who should i vote,which party,best party,best candidate,political party,party manifesto,bjp,congress,aap,exit poll,opinion poll,election result,predict,legal advice,sue ,lawyer

# ---- Shell (Electron main process). Only the service token is a secret. ----
RAG_URL=http://127.0.0.1:8008
# cline = Cline SDK planner (default), fallback = plain tool-calling loop
PLANNER_IMPL=cline
# hosted = OpenAI-compatible endpoint (e.g. Cline API or your backend), ollama = local
PLANNER=ollama
PLANNER_URL=http://127.0.0.1:11434/v1
PLANNER_MODEL=gemma4:12b
# Only for PLANNER=hosted. Keep on the backend where possible.
PLANNER_API_KEY=
HOTKEY=Ctrl+Shift+Space
SEARCH_COMMAND_PHRASES=findyt
# Route catalogs for "guide me to <service>" (comma separated, relative to the repo root). Their hosts are allowlisted.
ROUTE_CATALOGS=parivahan.UP.json
ALLOWED_HOSTS=eci.gov.in,www.eci.gov.in,voters.eci.gov.in,uidai.gov.in,myaadhaar.uidai.gov.in,google.com,www.google.com,youtube.com,www.youtube.com
HELPLINE_FALLBACK=Voter Helpline 1950 | UIDAI 1947
START_URL=https://voters.eci.gov.in/
DEBUG_LOG=0
